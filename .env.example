# =====================================================================
# GuardGap experiment — secrets & IDs
# Copy this file to  .env  and fill in the values.  NEVER commit .env
# (it is in .gitignore).  Nothing here is provided by the assistant —
# every value comes from YOUR cloud/HF accounts.  Where to get each one
# is written above it.
# =====================================================================

# ---------------------------------------------------------------------
# AWS Bedrock Guardrails
# ---------------------------------------------------------------------
# Get keys: AWS Console -> IAM -> Users -> your user -> Security
#   credentials -> Create access key (CLI use case).  The IAM user needs
#   the policy "AmazonBedrockFullAccess" (or a scoped policy allowing
#   bedrock:CreateGuardrail, CreateGuardrailVersion, ApplyGuardrail).
# Region must be one where Bedrock Guardrails is available (us-east-1,
#   us-west-2, eu-central-1, ap-northeast-1, ...).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Filled in for you by  infra/aws_provision_guardrail.py  (do not guess):
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# ---------------------------------------------------------------------
# Azure AI Content Safety  (Prompt Shields + text moderation)
# ---------------------------------------------------------------------
# Create the resource: Azure Portal -> Create resource -> "Content
#   Safety" (or run infra/azure_provision.sh).  Then: resource ->
#   Keys and Endpoint -> copy KEY 1 and the Endpoint.
# Endpoint looks like: https://<name>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# ---------------------------------------------------------------------
# Google Vertex AI Model Armor
# ---------------------------------------------------------------------
# Auth: install gcloud, run  gcloud auth application-default login  (the
#   SDK picks up those credentials automatically — no key file needed).
#   Alternatively set GOOGLE_APPLICATION_CREDENTIALS to a service-account
#   JSON key path.
# Create the template with infra/gcp_provision.sh, which fills TEMPLATE_ID.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=
# Optional: only if using a service-account key file instead of ADC
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------
# Hugging Face  (Prompt Guard 2 — local, gated Meta model)
# ---------------------------------------------------------------------
# Token: https://huggingface.co/settings/tokens  -> New token (Read).
# You must ALSO accept the licence on the model page while logged in:
#   https://huggingface.co/meta-llama/Llama-Prompt-Guard-2-86M
HF_TOKEN=

# ---------------------------------------------------------------------
# Llama Guard 4  (hosted — pick ONE provider)
# ---------------------------------------------------------------------
# OpenRouter: https://openrouter.ai/keys  (model meta-llama/llama-guard-4-12b)
# Together:   https://api.together.ai/settings/api-keys
# Groq:       https://console.groq.com/keys
LLAMA_GUARD_PROVIDER=openrouter        # openrouter | together | groq
LLAMA_GUARD_API_KEY=
LLAMA_GUARD_MODEL=meta-llama/llama-guard-4-12b

# ---------------------------------------------------------------------
# Optional reference guardrails (extended version — leave blank for MVP)
# ---------------------------------------------------------------------
# Lakera Guard: https://platform.lakera.ai  -> API keys
LAKERA_API_KEY=
# OpenAI Moderation: https://platform.openai.com/api-keys
OPENAI_API_KEY=
